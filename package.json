{
  "name": "home-ops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "db:generate": "pnpm --filter @home-ops/server db:generate",
    "db:migrate": "pnpm --filter @home-ops/server db:migrate",
    "db:migrate:deploy": "pnpm --filter @home-ops/server db:migrate:deploy",
    "db:seed": "pnpm --filter @home-ops/server db:seed",
    "db:studio": "pnpm --filter @home-ops/server db:studio",
    "db:bootstrap-admin": "pnpm --filter @home-ops/server db:bootstrap-admin",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
