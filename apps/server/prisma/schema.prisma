generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleStatus {
  ACTIVE
  DISABLED
}

enum PermissionStatus {
  ACTIVE
  DISABLED
}

enum PermissionType {
  PAGE
  ACTION
}

enum ResourceStatus {
  ACTIVE
  DISABLED
}

enum ScopeType {
  GLOBAL
  NODE
  STORAGE
  SERVICE
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum AuthLoginThrottleScope {
  USERNAME
  IP
}

model User {
  id                 String              @id @db.Char(36)
  username           String              @unique(map: "users_username_key") @db.VarChar(64)
  displayName        String?             @map("display_name") @db.VarChar(100)
  status             UserStatus          @default(ACTIVE)
  locale             String?             @db.VarChar(10)
  authVersion        Int                 @default(1) @map("auth_version")
  isSuperAdmin       Boolean             @default(false) @map("is_super_admin")
  mustChangePassword Boolean             @default(false) @map("must_change_password")
  lastLoginAt        DateTime?           @map("last_login_at") @db.DateTime(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  smbBinding         SmbBinding?
  fileOperations     FileOperation[]
  downloadTickets    DownloadTicket[]
  passwordCredential PasswordCredential?
  roleAssignments    RoleAssignment[]

  @@map("users")
}

model Role {
  id              String           @id @db.Char(36)
  code            String           @unique(map: "roles_code_key") @db.VarChar(64)
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  status          RoleStatus       @default(ACTIVE)
  isSystem        Boolean          @default(false) @map("is_system")
  createdBy       String?          @map("created_by") @db.Char(36)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  permissions     RolePermission[]
  roleAssignments RoleAssignment[]

  @@map("roles")
}

model Resource {
  id          String         @id @db.Char(36)
  code        String         @unique(map: "resources_code_key") @db.VarChar(128)
  module      String         @db.VarChar(64)
  name        String         @db.VarChar(100)
  description String?        @db.VarChar(255)
  icon        String?        @db.VarChar(64)
  sortOrder   Int            @default(0) @map("sort_order")
  status      ResourceStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  permissions Permission[]

  @@map("resources")
}

model Permission {
  id          String           @id @db.Char(36)
  code        String           @unique(map: "permissions_code_key") @db.VarChar(128)
  action      String           @db.VarChar(64)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  type        PermissionType   @default(ACTION)
  parentId    String?          @map("parent_id") @db.Char(36)
  sortOrder   Int              @default(0) @map("sort_order")
  status      PermissionStatus @default(ACTIVE)
  resourceId  String           @map("resource_id") @db.Char(36)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  parent      Permission?      @relation("PermissionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Permission[]     @relation("PermissionHierarchy")
  roles       RolePermission[]
  resource    Resource         @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([parentId, sortOrder])
  @@index([resourceId])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  grantedBy    String?    @map("granted_by") @db.Char(36)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id         String    @id @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  roleId     String    @map("role_id") @db.Char(36)
  scopeType  ScopeType @default(GLOBAL) @map("scope_type")
  scopeId    String    @default("*") @map("scope_id") @db.VarChar(64)
  assignedBy String?   @map("assigned_by") @db.Char(36)
  expiresAt  DateTime? @map("expires_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId], map: "role_assignments_scope_key")
  @@index([userId, scopeType, scopeId])
  @@index([roleId])
  @@map("role_assignments")
}

model AuditLog {
  id          String      @id @db.Char(36)
  actorUserId String?     @map("actor_user_id") @db.Char(36)
  action      String      @db.VarChar(128)
  targetType  String      @map("target_type") @db.VarChar(64)
  targetId    String?     @map("target_id") @db.VarChar(64)
  result      AuditResult @default(SUCCESS)
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model AuthLoginThrottle {
  scopeType       AuthLoginThrottleScope @map("scope_type")
  keyHash         String                 @map("key_hash") @db.Char(64)
  failureCount    Int                    @default(0) @map("failure_count")
  cooldownLevel   Int                    @default(0) @map("cooldown_level")
  windowStartedAt DateTime?              @map("window_started_at") @db.DateTime(3)
  lastFailureAt   DateTime?              @map("last_failure_at") @db.DateTime(3)
  cooldownUntil   DateTime?              @map("cooldown_until") @db.DateTime(3)
  blockedAttempts Int                    @default(0) @map("blocked_attempts")
  limitedAuditAt  DateTime?              @map("limited_audit_at") @db.DateTime(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([scopeType, keyHash])
  @@index([lastFailureAt])
  @@index([cooldownUntil])
  @@map("auth_login_throttles")
}

model AuthLoginVerificationReservation {
  id              String   @id @db.Char(36)
  usernameKeyHash String   @map("username_key_hash") @db.Char(64)
  ipKeyHash       String   @map("ip_key_hash") @db.Char(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt       DateTime @map("expires_at") @db.DateTime(3)

  @@index([usernameKeyHash, expiresAt], map: "auth_login_res_username_expires_idx")
  @@index([ipKeyHash, expiresAt], map: "auth_login_res_ip_expires_idx")
  @@index([expiresAt], map: "auth_login_res_expires_idx")
  @@map("auth_login_verification_reservations")
}

model PasswordCredential {
  userId            String   @id @map("user_id") @db.Char(36)
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.DateTime(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model SmbBinding {
  userId            String   @id @map("user_id") @db.Char(36)
  username          String   @db.VarChar(256)
  ciphertext        String   @db.Text
  nonce             String   @db.VarChar(32)
  authTag           String   @map("auth_tag") @db.VarChar(32)
  keyId             String   @map("key_id") @db.VarChar(32)
  version           String   @db.Char(36)
  configFingerprint String   @map("config_fingerprint") @db.Char(64)
  lastCheckedAt     DateTime @map("last_checked_at") @db.DateTime(3)
  lastCheckCode     String   @map("last_check_code") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("smb_bindings")
}

model FileOperation {
  id                String   @id @db.Char(36)
  userId            String   @map("user_id") @db.Char(36)
  bindingVersion    String   @map("binding_version") @db.Char(36)
  configFingerprint String   @map("config_fingerprint") @db.Char(64)
  authVersion       Int      @map("auth_version")
  requestId         String   @map("request_id") @db.Char(36)
  relativePath      String   @map("relative_path") @db.Text
  tempPath          String   @map("temp_path") @db.Text
  objectId          String?  @map("object_id") @db.VarChar(64)
  expectedBytes     BigInt   @map("expected_bytes")
  transferredBytes  BigInt   @default(0) @map("transferred_bytes")
  state             String   @db.VarChar(32)
  errorCode         String?  @map("error_code") @db.VarChar(64)
  cleanupPending    Boolean  @default(false) @map("cleanup_pending")
  leaseExpiresAt    DateTime @map("lease_expires_at") @db.DateTime(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bindingVersion, requestId])
  @@index([state, leaseExpiresAt])
  @@map("file_operations")
}

model DownloadTicket {
  id                String    @id @db.Char(36)
  secretHash        String    @map("secret_hash") @db.Char(64)
  userId            String    @map("user_id") @db.Char(36)
  authVersion       Int       @map("auth_version")
  bindingVersion    String    @map("binding_version") @db.Char(36)
  configFingerprint String    @map("config_fingerprint") @db.Char(64)
  relativePath      String    @map("relative_path") @db.Text
  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  consumedAt        DateTime? @map("consumed_at") @db.DateTime(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("download_tickets")
}
