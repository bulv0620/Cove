DATABASE_URL="mysql://cove:change-me@127.0.0.1:3307/cove?allowPublicKeyRetrieval=true"
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Login brute-force protection. Limits are enforced by username and client IP.
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=600
AUTH_LOGIN_USERNAME_THRESHOLD=5
AUTH_LOGIN_IP_THRESHOLD=20
AUTH_LOGIN_BASE_COOLDOWN_SECONDS=30
AUTH_LOGIN_MAX_COOLDOWN_SECONDS=900
AUTH_LOGIN_RESET_SECONDS=1800
AUTH_LOGIN_RESERVATION_SECONDS=30
AUTH_LOGIN_STATE_RETENTION_HOURS=24
# Comma-separated proxy CIDRs. Leave empty to ignore all forwarded-IP headers.
AUTH_TRUSTED_PROXY_CIDRS=

# Docker Compose connects to an externally managed MySQL instance. Use an address
# reachable from the application container, not 127.0.0.1 inside the container.
# DATABASE_URL="mysql://cove:YOUR_URL_ENCODED_PASSWORD@NAS_OR_DB_HOST:3306/cove?allowPublicKeyRetrieval=true"
WEB_PORT=8080
COVE_VERSION=local

# Personal SMB Files. Credentials are bound per user, never configured here.
SMB_ENABLED=false
SMB_HOST=
SMB_PORT=445
SMB_SHARE=home
SMB_DOMAIN=
SMB_ENCRYPTION_REQUIRED=true
SMB_CREDENTIAL_KEY_ID=v1
# Independent random 32-byte base64 key. Never reuse JWT_SECRET.
SMB_CREDENTIAL_KEY=
# Optional JSON map of previous key IDs to base64 keys during rotation.
SMB_CREDENTIAL_PREVIOUS_KEYS={}
SMB_CONNECT_TIMEOUT_MS=10000
SMB_IO_IDLE_TIMEOUT_MS=60000
FILES_MAX_UPLOAD_BYTES=10737418240
FILES_MAX_ACTIVE_PER_USER=2
FILES_MAX_ACTIVE_GLOBAL=8
FILES_MAX_QUEUED_PER_USER=100
FILES_MAX_DIRECTORY_ENTRIES=50000
FILES_DIRECTORY_TIMEOUT_MS=30000
# Only for a loopback HTTP development server. Ignored in production.
FILES_ALLOW_INSECURE_LOCAL_COOKIE=false
# Optional Python 3.11+ executable; local default is .venv/bin/python.
# SMB_PYTHON=/absolute/path/to/python
