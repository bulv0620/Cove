DATABASE_URL="mysql://home_ops:change-me@127.0.0.1:3307/home_ops?allowPublicKeyRetrieval=true"
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Docker Compose only: use mysql:3306 instead of the local development address.
# DATABASE_URL="mysql://home_ops:YOUR_URL_ENCODED_PASSWORD@mysql:3306/home_ops?allowPublicKeyRetrieval=true"
# MYSQL_PASSWORD must match the decoded password in DATABASE_URL.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
WEB_PORT=8080
HOME_OPS_VERSION=local
